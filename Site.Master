<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="ClinicManagement.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - MediCare Clinic</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-brand {
            font-weight: 700;
            color: #0d6efd !important;
            letter-spacing: -0.5px;
        }
        .navbar-brand i {
            color: #0dcaf0;
        }
        .nav-link {
            font-weight: 500;
            color: #475569;
            transition: color 0.2s;
        }
        .nav-link:hover, .nav-link.active {
            color: #0d6efd !important;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        }
        .card-header {
            background-color: #ffffff;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 600;
            padding: 1rem 1.25rem;
            border-top-left-radius: 14px !important;
            border-top-right-radius: 14px !important;
        }
        .btn {
            border-radius: 8px;
            font-weight: 500;
            padding: 0.5rem 1rem;
            transition: all 0.2s;
        }
        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        .btn-primary:hover {
            background-color: #0b5ed7;
            transform: translateY(-1px);
        }
        .table {
            vertical-align: middle;
        }
        .table thead th {
            background-color: #f8fafc;
            color: #475569;
            font-size: 0.825rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            border-bottom: 2px solid #e2e8f0;
        }
        .footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
            padding: 1.25rem 0;
            color: #64748b;
        }
        .avatar-circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.18);
        }
        .avatar-circle i {
            margin: 0;
            padding: 0;
            line-height: 1;
            display: inline-block;
        }
        .badge-pending {
            background-color: #fef3c7;
            color: #92400e;
        }
        .badge-confirmed {
            background-color: #e0f2fe;
            color: #0369a1;
        }
        .badge-completed {
            background-color: #dcfce7;
            color: #166534;
        }
        .badge-cancelled {
            background-color: #fee2e2;
            color: #991b1b;
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="Default.aspx">
                    <i class="fa-solid fa-heart-pulse fa-lg text-primary"></i>
                    <span>MediCare<span class="text-dark">Clinic</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="Default.aspx"><i class="fa-solid fa-house me-1"></i> Home</a>
                        </li>

                        <!-- Patient Only Links -->
                        <asp:PlaceHolder ID="phPatientNav" runat="server" Visible="false">
                            <li class="nav-item">
                                <a class="nav-link" href="BookAppointment.aspx"><i class="fa-solid fa-calendar-plus me-1"></i> Book Appointment</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="MyAppointments.aspx"><i class="fa-solid fa-clock-rotate-left me-1"></i> My Appointments</a>
                            </li>
                        </asp:PlaceHolder>

                        <!-- Doctor / Admin Only Links -->
                        <asp:PlaceHolder ID="phDoctorNav" runat="server" Visible="false">
                            <li class="nav-item">
                                <a class="nav-link" href="DoctorDashboard.aspx"><i class="fa-solid fa-stethoscope me-1"></i> Doctor Queue</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="ManageDoctors.aspx"><i class="fa-solid fa-user-doctor me-1"></i> Doctors Directory</a>
                            </li>
                        </asp:PlaceHolder>
                    </ul>

                    <!-- Right Side: User Profile / Login Buttons -->
                    <ul class="navbar-nav align-items-lg-center">
                        <asp:PlaceHolder ID="phGuestNav" runat="server" Visible="true">
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary" href="Login.aspx"><i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" href="Register.aspx"><i class="fa-solid fa-user-plus me-1"></i> Register</a>
                            </li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phUserNav" runat="server" Visible="false">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark fw-semibold" href="#" id="userMenu" role="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-circle-user fa-lg text-primary me-1"></i>
                                    <asp:Literal ID="litUserName" runat="server"></asp:Literal>
                                    <span class="badge bg-secondary-subtle text-secondary border ms-1">
                                        <asp:Literal ID="litUserRole" runat="server"></asp:Literal>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item" href="Default.aspx"><i class="fa-solid fa-house me-2"></i> Overview</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="Logout.aspx"><i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out</a></li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Main Body Content -->
        <main class="py-4">
            <div class="container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </main>

        <!-- Footer -->
        <footer class="footer py-3 text-center bg-white border-top">
            <div class="container">
                <span class="small text-muted">MediCare Clinic Management System &copy; <%: DateTime.Now.Year %>. All rights reserved.</span>
            </div>
        </footer>
    </form>

    <!-- Bootstrap 5 Bundle JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>

