<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <connectionStrings>
    <!-- Change Server name if you use SQL Express: Server=localhost\SQLEXPRESS or (localdb)\MSSQLLocalDB -->
    <add name="ClinicDB" 
         connectionString="Data Source=.;Initial Catalog=ClinicDB;Integrated Security=True;TrustServerCertificate=True" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <sessionState timeout="60" mode="InProc" />
    <!-- Disables unobtrusive validation so standard ASP.NET validators work out of the box -->
    <pages>
    </pages>
  </system.web>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <defaultDocument enabled="true">
      <files>
        <remove value="default.aspx" />
        <remove value="Default.aspx" />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>

